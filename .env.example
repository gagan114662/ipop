# Application Settings
APP_NAME=IPOP Media Buying Management System
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# API Settings
API_V1_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000

# Security & JWT
SECRET_KEY=your-secret-key-min-32-characters-long-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=ipop_media_buying
MONGODB_MAX_CONNECTIONS=100
MONGODB_MIN_CONNECTIONS=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Rate Limiting
RATE_LIMIT_PER_MINUTE=1000
RATE_LIMIT_ENABLED=True

# Performance Thresholds
API_RESPONSE_TIME_MAX_MS=500
INTELLIGENCE_DECISION_MAX_MS=2000

# Intelligence Settings
IMPRESSION_THRESHOLD=1000
EXPLORE_BUDGET_PERCENTAGE=20
EXPLOIT_BUDGET_PERCENTAGE=5
MIN_CAMPAIGN_BUDGET_USD=100
EXPLORE_MODE_DAYS=7

# Google Cloud Platform
GCP_PROJECT_ID=your-gcp-project-id
GCP_SECRET_MANAGER_ENABLED=False

# Platform API Credentials (or use GCP Secret Manager)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

TIKTOK_APP_ID=
TIKTOK_SECRET=
TIKTOK_ACCESS_TOKEN=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# Integrator API Keys
REVEALBOT_API_KEY=
ADROLL_API_KEY=
ADROLL_API_SECRET=
STACKADAPT_API_KEY=
ADESPRESSO_API_KEY=
MADGICX_API_KEY=

# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Geographic Settings
DEFAULT_TIMEZONE=UTC
SUPPORTED_REGIONS=["NA", "EU"]
CURRENCY_USD=USD

# Scheduler
HOURLY_OPTIMIZATION_ENABLED=True
OPTIMIZATION_CRON=0 * * * *  # Every hour at minute 0

# Testing
TEST_DATABASE_NAME=ipop_test
