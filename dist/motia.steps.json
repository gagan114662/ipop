                "type": "object",
                "properties": {
                  "openai": {
                    "type": "boolean"
                  },
                  "gemini": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "openai",
                  "gemini"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "status",
              "message",
              "services"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        },
        "emits": []
      },
      "filePath": "/Users/gaganarora/Desktop/projects/motiacreative-development/steps/health-check.step.ts"
