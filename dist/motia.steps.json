{
  "steps": {
    "node/steps/process-brand.step.zip": {
      "type": "node",
      "entrypointPath": "/steps/process-brand.step.js",
      "config": {
        "type": "event",
        "name": "ProcessBrand",
        "description": "Autonomous workflow that extracts SKUs, analyzes brand, researches competitors, curates award references, and generates elevated creatives",
        "flows": [
          "marketing-agency"
        ],
        "subscribes": [
          "process-brand"
        ],
        "emits": [
          "campaign-complete"
        ],
        "input": {
          "type": "object",
          "properties": {
            "campaignId": {
              "type": "string"
            },
            "websiteUrl": {
              "type": "string"
            },
            "brandName": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            }
          },
          "required": [
            "campaignId",
            "websiteUrl",
            "brandName",
            "timestamp"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        }
      },
      "filePath": "/Users/gaganarora/Desktop/projects/motiacreative-development/steps/process-brand.step.ts"
    },
    "node/steps/ingest-brand.step.zip": {
      "type": "node",
      "entrypointPath": "/steps/ingest-brand.step.js",
      "config": {
        "type": "api",
        "name": "IngestBrand",
        "description": "Accepts a brand website URL and initiates the autonomous marketing agency workflow",
        "flows": [
          "marketing-agency"
        ],
        "method": "POST",
        "path": "/api/ingest-brand",
        "bodySchema": {
          "type": "object",
          "properties": {
            "websiteUrl": {
              "type": "string",
              "format": "uri"
            },
            "brandName": {
              "type": "string"
            }
          },
          "required": [
            "websiteUrl"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "responseSchema": {
          "200": {
            "type": "object",
            "properties": {
              "campaignId": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            },
            "required": [
              "campaignId",
              "message",
              "status"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        },
        "emits": [
          "process-brand"
        ]
      },
      "filePath": "/Users/gaganarora/Desktop/projects/motiacreative-development/steps/ingest-brand.step.ts"
    },
    "node/steps/health-check.step.zip": {
      "type": "node",
      "entrypointPath": "/steps/health-check.step.js",
      "config": {
        "type": "api",
        "name": "HealthCheck",
